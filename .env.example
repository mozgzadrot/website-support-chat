# ── OpenRouter ────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4-5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── App Identity (used in OpenRouter attribution headers) ──
SITE_URL=http://localhost:5000
APP_NAME=Zephyr Demo Chat

# ── Embedding model ────────────────────────────────────────
# Swap to BAAI/bge-m3 for higher quality (slower, larger)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── RAG & Cache tuning ─────────────────────────────────────
# Raise CACHE_SIMILARITY_THRESHOLD (e.g. 0.96) for stricter cache hits
# Lower it (e.g. 0.88) to cache more aggressively
CACHE_SIMILARITY_THRESHOLD=0.92

# Number of KB sections to inject into the prompt
RAG_TOP_K=4

# Minimum cosine similarity to include a KB section
RAG_MIN_SCORE=0.35

# Number of conversation turn-pairs to include for context
MAX_HISTORY_TURNS=6

# ── Storage ────────────────────────────────────────────────
DB_PATH=data/chat.db

# ── Server ────────────────────────────────────────────────
LOG_LEVEL=INFO
FLASK_ENV=development
